# Copy to server/.env and fill in. Never commit the real .env file.

NODE_ENV=development
PORT=5000

# MongoDB connection string. Local: mongodb://127.0.0.1:27017/eventhub
# Atlas: mongodb+srv://<user>:<password>@<cluster>/eventhub?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/eventhub

# Long random string used to sign session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d

# Only set when the React app is hosted on a DIFFERENT origin than the API
# (comma-separated). Leave empty when the API serves the built client itself.
CLIENT_ORIGIN=

# Number of reverse proxies in front of the app (defaults to 1 in production).
# TRUST_PROXY=1

# Used by `npm run seed` to create/update the first admin account.
ADMIN_EMAIL=admin@eventhub.local
ADMIN_PASSWORD=change-this-admin-password
ADMIN_NAME=EventHub Admin
